{
  "about": "Shared layer 2 (taint) test vectors. Run by extension/test/taint.test.ts and capture/src/test/.../TaintScrubberTest.kt. Inputs and outputs are UTF-8 text; scrubbing works on its bytes. See docs/CAPTURE.md section 5. Cases with \"validJson\" are JSON documents whose output must parse, including every string that holds JSON (a numeric secret in a number position is written as a quoted placeholder).",
  "minTaintLength": 8,
  "stopList": [
    "true",
    "false",
    "null",
    "undefined",
    "deleted"
  ],
  "cases": [
    {
      "name": "plain value in JSON and text",
      "secrets": [
        {
          "value": "AbCdEf123456",
          "label": "cookie:xs"
        }
      ],
      "input": "{\"a\":\"AbCdEf123456\",\"b\":\"x AbCdEf123456 y\"}",
      "output": "{\"a\":\"!T:cookie:xs!\",\"b\":\"x !T:cookie:xs! y\"}",
      "counts": {
        "cookie:xs": 2
      }
    },
    {
      "name": "URL-encoded, form-encoded and JSON slash-escaped variants",
      "secrets": [
        {
          "value": "tok:en/val+ue=1 z",
          "label": "field:fb_dtsg"
        }
      ],
      "input": "fb_dtsg=tok%3Aen%2Fval%2Bue%3D1%20z&q=tok%3Aen%2Fval%2Bue%3D1+z; \"v\":\"tok:en\\/val+ue=1 z\" raw tok:en/val+ue=1 z",
      "output": "fb_dtsg=!T:field:fb_dtsg!&q=!T:field:fb_dtsg!; \"v\":\"!T:field:fb_dtsg!\" raw !T:field:fb_dtsg!",
      "counts": {
        "field:fb_dtsg": 4
      }
    },
    {
      "name": "value shorter than minTaintLength is not scrubbed",
      "secrets": [
        {
          "value": "1234567",
          "label": "field:jazoest"
        }
      ],
      "input": "jazoest=1234567 and 1234567",
      "output": "jazoest=1234567 and 1234567",
      "counts": {}
    },
    {
      "name": "stop-list value is not scrubbed",
      "secrets": [
        {
          "value": "Undefined",
          "label": "cookie:x"
        }
      ],
      "input": "undefined Undefined",
      "output": "undefined Undefined",
      "counts": {}
    },
    {
      "name": "one repeated character is not scrubbed",
      "secrets": [
        {
          "value": "aaaaaaaaaa",
          "label": "cookie:y"
        }
      ],
      "input": "aaaaaaaaaaaa",
      "output": "aaaaaaaaaaaa",
      "counts": {}
    },
    {
      "name": "layer 1 placeholder is not a secret",
      "secrets": [
        {
          "value": "!R******!",
          "label": "cookie:z"
        }
      ],
      "input": "c=!R******!",
      "output": "c=!R******!",
      "counts": {}
    },
    {
      "name": "leftmost-longest match wins",
      "secrets": [
        {
          "value": "ABCDEFGH12",
          "label": "cookie:short"
        },
        {
          "value": "ABCDEFGH1234",
          "label": "cookie:long"
        }
      ],
      "input": "xxABCDEFGH1234yy ABCDEFGH12zz",
      "output": "xx!T:cookie:long!yy !T:cookie:short!zz",
      "counts": {
        "cookie:long": 1,
        "cookie:short": 1
      }
    },
    {
      "name": "shared variant keeps the first label",
      "secrets": [
        {
          "value": "SameValue99",
          "label": "cookie:first"
        },
        {
          "value": "SameValue99",
          "label": "field:second"
        }
      ],
      "input": "[SameValue99]",
      "output": "[!T:cookie:first!]",
      "counts": {
        "cookie:first": 1
      }
    },
    {
      "name": "non-ASCII value, raw and URL-encoded",
      "secrets": [
        {
          "value": "pässwörd-é😀",
          "label": "field:pass"
        }
      ],
      "input": "a pässwörd-é😀 b p%C3%A4ssw%C3%B6rd-%C3%A9%F0%9F%98%80 c",
      "output": "a !T:field:pass! b !T:field:pass! c",
      "counts": {
        "field:pass": 2
      }
    },
    {
      "name": "JSON-escaped twice",
      "secrets": [
        {
          "value": "a\"b\\c-12345",
          "label": "field:token"
        }
      ],
      "input": "{\"x\":\"{\\\"t\\\":\\\"a\\\\\\\"b\\\\\\\\c-12345\\\"}\",\"y\":\"a\\\"b\\\\c-12345\"}",
      "output": "{\"x\":\"{\\\"t\\\":\\\"!T:field:token!\\\"}\",\"y\":\"!T:field:token!\"}",
      "counts": {
        "field:token": 2
      }
    },
    {
      "name": "HTML-escaped",
      "secrets": [
        {
          "value": "a&b<c>\"d'e12",
          "label": "field:lsd"
        }
      ],
      "input": "<input value=\"a&amp;b&lt;c&gt;&quot;d&#39;e12\">",
      "output": "<input value=\"!T:field:lsd!\">",
      "counts": {
        "field:lsd": 1
      }
    },
    {
      "name": "label characters are sanitized",
      "secrets": [
        {
          "value": "Weird-Label-Value-1",
          "label": "cookie:we ird/name"
        }
      ],
      "input": "Weird-Label-Value-1",
      "output": "!T:cookie:we_ird_name!",
      "counts": {
        "cookie:we_ird_name": 1
      }
    },
    {
      "name": "control character escaped in JSON",
      "secrets": [
        {
          "value": "line1\nline2xx",
          "label": "field:token"
        }
      ],
      "input": "{\"t\":\"line1\\nline2xx\"}",
      "output": "{\"t\":\"!T:field:token!\"}",
      "counts": {
        "field:token": 1
      }
    },
    {
      "name": "no secrets leaves data unchanged",
      "secrets": [],
      "input": "nothing to do 😀",
      "output": "nothing to do 😀",
      "counts": {}
    },
    {
      "name": "numeric secret as a bare JSON number becomes a quoted placeholder",
      "secrets": [
        {
          "value": "100012345678",
          "label": "cookie:c_user"
        }
      ],
      "input": "{\"userID\":100012345678,\"n\":1}",
      "output": "{\"userID\":\"!T:cookie:c_user!\",\"n\":1}",
      "counts": {
        "cookie:c_user": 1
      },
      "validJson": true
    },
    {
      "name": "numeric secret as array elements, with blanks around them",
      "secrets": [
        {
          "value": "100012345678",
          "label": "cookie:c_user"
        }
      ],
      "input": "{\"ids\":[100012345678, 2,\n 100012345678 ]}",
      "output": "{\"ids\":[\"!T:cookie:c_user!\", 2,\n \"!T:cookie:c_user!\" ]}",
      "counts": {
        "cookie:c_user": 2
      },
      "validJson": true
    },
    {
      "name": "numeric secret already in a string keeps the plain placeholder",
      "secrets": [
        {
          "value": "100012345678",
          "label": "cookie:c_user"
        }
      ],
      "input": "{\"id\":\"100012345678\",\"t\":\"id 100012345678 here\"}",
      "output": "{\"id\":\"!T:cookie:c_user!\",\"t\":\"id !T:cookie:c_user! here\"}",
      "counts": {
        "cookie:c_user": 2
      },
      "validJson": true
    },
    {
      "name": "bare number inside JSON held in a JSON string gets escaped quotes",
      "secrets": [
        {
          "value": "100012345678",
          "label": "cookie:c_user"
        }
      ],
      "input": "{\"s\":\"{\\\"userID\\\":100012345678}\"}",
      "output": "{\"s\":\"{\\\"userID\\\":\\\"!T:cookie:c_user!\\\"}\"}",
      "counts": {
        "cookie:c_user": 1
      },
      "validJson": true
    },
    {
      "name": "string that holds a JSON array starting with the number",
      "secrets": [
        {
          "value": "100012345678",
          "label": "cookie:c_user"
        }
      ],
      "input": "{\"s\":\"[100012345678,1]\"}",
      "output": "{\"s\":\"[\\\"!T:cookie:c_user!\\\",1]\"}",
      "counts": {
        "cookie:c_user": 1
      },
      "validJson": true
    },
    {
      "name": "bare number two levels of JSON-in-a-string deep",
      "secrets": [
        {
          "value": "100012345678",
          "label": "cookie:c_user"
        }
      ],
      "input": "{\"a\":\"{\\\"b\\\":\\\"{\\\\\\\"c\\\\\\\":100012345678}\\\"}\"}",
      "output": "{\"a\":\"{\\\"b\\\":\\\"{\\\\\\\"c\\\\\\\":\\\\\\\"!T:cookie:c_user!\\\\\\\"}\\\"}\"}",
      "counts": {
        "cookie:c_user": 1
      },
      "validJson": true
    },
    {
      "name": "previous string ends in an escaped backslash",
      "secrets": [
        {
          "value": "100012345678",
          "label": "cookie:c_user"
        }
      ],
      "input": "[\"a\\\\\",100012345678]",
      "output": "[\"a\\\\\",\"!T:cookie:c_user!\"]",
      "counts": {
        "cookie:c_user": 1
      },
      "validJson": true
    },
    {
      "name": "number in a page script is quoted too",
      "secrets": [
        {
          "value": "100012345678",
          "label": "cookie:c_user"
        }
      ],
      "input": "<script>window.__boot = [\"tok\", 100012345678];</script>",
      "output": "<script>window.__boot = [\"tok\", \"!T:cookie:c_user!\"];</script>",
      "counts": {
        "cookie:c_user": 1
      }
    },
    {
      "name": "not a JSON number position: URL, form field, longer number, text",
      "secrets": [
        {
          "value": "100012345678",
          "label": "cookie:c_user"
        }
      ],
      "input": "u=/x?id=100012345678&y=1 f=100012345678, n:1000123456789 t 100012345678",
      "output": "u=/x?id=!T:cookie:c_user!&y=1 f=!T:cookie:c_user!, n:!T:cookie:c_user!9 t !T:cookie:c_user!",
      "counts": {
        "cookie:c_user": 4
      }
    },
    {
      "name": "a non-numeric secret in a number position keeps the plain placeholder",
      "secrets": [
        {
          "value": "AbCdEf123456",
          "label": "cookie:xs"
        }
      ],
      "input": "[AbCdEf123456]",
      "output": "[!T:cookie:xs!]",
      "counts": {
        "cookie:xs": 1
      }
    },
    {
      "name": "numeric secret in a comma list inside a string is text; as a value keyed by itself it is a number",
      "secrets": [
        {
          "value": "100012345678",
          "label": "cookie:c_user"
        }
      ],
      "input": "{\"s\":\"{\\\"k\\\":\\\"a1,100012345678,-1\\\",\\\"m\\\":{\\\"100012345678\\\":100012345678}}\"}",
      "output": "{\"s\":\"{\\\"k\\\":\\\"a1,!T:cookie:c_user!,-1\\\",\\\"m\\\":{\\\"!T:cookie:c_user!\\\":\\\"!T:cookie:c_user!\\\"}}\"}",
      "counts": {
        "cookie:c_user": 3
      },
      "validJson": true
    },
    {
      "name": "comma list at the top level of a string value stays as text",
      "secrets": [
        {
          "value": "100012345678",
          "label": "cookie:c_user"
        }
      ],
      "input": "{\"k\":\"x,100012345678,y\",\"n\":[1,100012345678]}",
      "output": "{\"k\":\"x,!T:cookie:c_user!,y\",\"n\":[1,\"!T:cookie:c_user!\"]}",
      "counts": {
        "cookie:c_user": 2
      },
      "validJson": true
    }
  ]
}
